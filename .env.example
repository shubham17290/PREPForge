# ─── GATE CS & IT PYQ Platform — Environment Variables Reference ───
# Copy this file to `.env` locally. NEVER commit a real `.env` file.

# ─── Database (PostgreSQL, used by Prisma + backend) ───
# postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="YOUR_DATABASE_URL"

# ─── Backend ───
# Port the backend API server listens on.
PORT="YOUR_PORT"

# Base URL of the backend API, as reachable from the browser (frontend → backend).
NEXT_PUBLIC_API_BASE_URL="YOUR_BACKEND_API_BASE_URL"

# Approved browser origin for credentialed CORS requests.
FRONTEND_ORIGIN="YOUR_FRONTEND_ORIGIN"

# ─── Application ───
# Runtime environment: development | test | production
NODE_ENV="YOUR_NODE_ENV"

# ─── Test Database (isolated, never production) ───
# Dedicated Postgres for integration tests. MUST be an isolated Neon branch
# or local database — NEVER the production DATABASE_URL.
# If missing, integration tests that require a DB will fail fast with a clear error.
# Example (isolated branch): postgresql://user:pass@ep-test-branch.neon.tech/neondb?sslmode=require
# Example (local): postgresql://postgres:postgres@localhost:5432/gate_pyq_test
TEST_DATABASE_URL="YOUR_TEST_DATABASE_URL"

# Optional backend tuning overrides.
SESSION_TTL_HOURS="YOUR_SESSION_TTL_HOURS"
RATE_LIMIT_LOGIN_PER_MIN="YOUR_RATE_LIMIT_LOGIN_PER_MIN"
RATE_LIMIT_GLOBAL_PER_MIN="YOUR_RATE_LIMIT_GLOBAL_PER_MIN"
AUTH_LOCKOUT_MAX_FAILS="YOUR_AUTH_LOCKOUT_MAX_FAILS"
AUTH_LOCKOUT_WINDOW_MIN="YOUR_AUTH_LOCKOUT_WINDOW_MIN"
PAGE_SIZE_DEFAULT="YOUR_PAGE_SIZE_DEFAULT"
PAGE_SIZE_MAX="YOUR_PAGE_SIZE_MAX"
PRACTICE_DEFAULT_COUNT="YOUR_PRACTICE_DEFAULT_COUNT"
PRACTICE_ABANDON_HOURS="YOUR_PRACTICE_ABANDON_HOURS"
PBKDF2_ITERATIONS="YOUR_PBKDF2_ITERATIONS"
AUDIT_DISABLED="YOUR_AUDIT_DISABLED"